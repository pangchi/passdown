# Copy this file to .env and fill in your Postgres credentials.
PASSDOWN_DB_HOST=localhost
PASSDOWN_DB_PORT=5432
PASSDOWN_DB_NAME=passdown
PASSDOWN_DB_USER=passdown
PASSDOWN_DB_PASSWORD=changeme

# Optional: port the Flask app listens on (default 5050)
PASSDOWN_APP_PORT=5050

# Timezone all timestamps are displayed/interpreted in (IANA name).
# Defaults to Asia/Singapore if not set.
PASSDOWN_TIMEZONE=Asia/Singapore

# --- MES foreign database (used only by scripts/setup_fdw.sh, not by the
# --- Flask app itself). This provisions postgres_fdw so the local
# --- mestoollist view can read live tool data from the MES database.
MES_FDW_HOST=localhost
MES_FDW_PORT=5432
MES_FDW_DBNAME=mes_db
MES_FDW_USER=mes_reader
MES_FDW_PASSWORD=changeme
# Schema name on the MES side that holds Tool_Selection / Location_Selection
MES_FDW_REMOTE_SCHEMA=public
